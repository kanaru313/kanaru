  "fixed_sql": [
    {
      "name": "library_roots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_roots\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"path\" TEXT NOT NULL UNIQUE, \"added_at\" INTEGER NOT NULL, \"last_scan_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tracks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"root_id\" INTEGER NOT NULL REFERENCES library_roots (id) ON DELETE CASCADE, \"path\" TEXT NOT NULL UNIQUE, \"mtime_ms\" INTEGER NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"artist\" TEXT NULL, \"album\" TEXT NULL, \"album_artist\" TEXT NULL, \"track_no\" INTEGER NULL, \"track_total\" INTEGER NULL, \"disc_no\" INTEGER NULL, \"disc_total\" INTEGER NULL, \"year\" INTEGER NULL, \"genre\" TEXT NULL, \"composer\" TEXT NULL, \"comment\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"bitrate\" INTEGER NULL, \"sample_rate\" INTEGER NULL, \"bit_depth\" INTEGER NULL, \"channels\" INTEGER NULL, \"added_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"scan_error\" TEXT NULL, \"cover_key\" TEXT NULL, \"cover_scan_version\" INTEGER NOT NULL DEFAULT 0, \"album_artist_key\" TEXT NULL, \"album_title_key\" TEXT NULL, \"album_display_artist\" TEXT NULL, \"title_sort\" TEXT NOT NULL DEFAULT '', \"artist_sort\" TEXT NULL, \"album_sort\" TEXT NULL, \"keys_version\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "track_artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"track_artists\" (\"track_id\" INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE, \"artist_key\" TEXT NOT NULL, \"artist_name\" TEXT NOT NULL, PRIMARY KEY (\"artist_key\", \"track_id\"));"
        }
      ]
    },
