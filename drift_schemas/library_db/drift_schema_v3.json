        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX tracks_title_sort ON tracks (title_sort, id)"
        }
      ]
    },
    {
      "name": "tracks_album_key",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX tracks_album_key ON tracks (album_artist_key, album_title_key)"
        }
      ]
